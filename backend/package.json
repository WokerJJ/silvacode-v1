{
  "name": "silvacode-backend",
  "version": "1.0.0",
  "description": "Backend de SilvaCode usando Node.js, Prisma y PostgreSQL",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "seed": "node prisma/seed.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "test": "node --test --test-concurrency=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "supertest": "^7.2.2"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "bcrypt@6.0.0": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
